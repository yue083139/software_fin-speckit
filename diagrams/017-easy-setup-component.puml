@startuml 017-easy-setup-component
title 017 easy-setup：組件圖

actor "老師（本機瀏覽器）" as Teacher
actor "學生手機" as Phone

node "老師電腦" {
  [start.cmd 與 start.ps1\n缺 uv 或 Node.js 時詢問 winget 代裝\n刷新 PATH 後繼續] as Launcher
  [cloudflared 子行程\n執行期起停] as CF
  file ".env（repo 根目錄，不入庫）\nGOOGLE_CLIENT_ID\nGOOGLE_CLIENT_SECRET" as Env
  package "server/quiz_server" {
    [__main__\nuvicorn.Server 就緒後\n開老師頁一次（--no-browser 可關）] as Main
    [app 老師端點\n先 is_local 再驗金鑰] as Api
    [app Google 設定端點\nGET 狀態・POST 設定・DELETE 清除] as Cfg
    [app 手機連線端點\nPOST 開啟・DELETE 關閉\ntunnel_lock 序列化] as TunApi
    [envfile\n只改兩鍵・原子寫入\n固定路徑] as EnvMod
    [google_auth.GoogleSession\nreconfigure・client_id_hint] as GS
    [tunnel.Tunnel\nstart・stop・find_cloudflared] as Tun
    [activity.Activity\npublic_url・tunnel 狀態] as Act
    [views.teacher_view\nstudent_url・tunnel（學生 view 不帶）] as Views
  }
}

package "web（老師頁）" {
  [SetupChecklist\n開始前的設定：Google・手機連線・題目] as Check
  [GooglePanel 設定精靈\n六步 Console 連結・複製重新導向 URI\n貼上 ID 與密鑰] as Wizard
  [StudentLink\n開啟或關閉手機連線・QRCode\n503 時顯示安裝指令] as Link
}

Launcher --> Main : uv run python -m quiz_server
Main --> Teacher : webbrowser.open（一次）
Teacher --> Check
Check ..> Wizard : 點 Google 列捲動
Check ..> Link : 點手機連線列捲動
Wizard --> Cfg : 儲存設定
Cfg --> EnvMod
EnvMod --> Env
Cfg --> GS : reconfigure 立即生效
Link --> TunApi : 開啟手機連線
TunApi --> Tun
Tun --> CF
TunApi --> Act : tunnel 與 public_url
Views --> Act
Phone --> CF : https 公開網址
note bottom of Cfg
  密鑰不回傳、不入日誌；白名單驗證
  已登入 Google 時 409
end note
@enduml
